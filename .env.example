# Optional API Keys for EAATS
# If left blank, EAATS automatically uses free fallback sources (yfinance, Google News RSS, StockTwits)

# Market Data Fallback (optional)
ALPHAVANTAGE_API_KEY=

# Reddit API Credentials for r/stocks, r/wallstreetbets (optional)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=eaats_academic_project:v1.0

# Twitter / X API (optional)
TWITTER_BEARER_TOKEN=
